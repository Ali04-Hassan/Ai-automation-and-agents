      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text.trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  parsed = { intent: 'faq', doctor: '', appointment_slot: '', new_slot: '' };\n}\n\nconst valid = ['booking','reschedule_cancel','faq','pre_appointment','emergency','after_hours'];\nconst intent = valid.includes(parsed.intent) ? parsed.intent : 'faq';\n\nlet base;\ntry {\n  base = $('Extract Message').first().json;\n} catch (e) {\n  base = $('Extract Message1').first().json;\n}\n\nreturn [{\n  json: {\n    ...base,\n    intent,\n    doctor: parsed.doctor || '',\n    appointment_slot: parsed.appointment_slot || '',\n    new_slot: parsed.new_slot || ''\n  }\n}];"
      },
